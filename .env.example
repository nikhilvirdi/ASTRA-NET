POSTGRES_USER=astranet
POSTGRES_PASSWORD=astranet_dev_password
POSTGRES_DB=astranet
DATABASE_URL=postgresql://astranet:astranet_dev_password@localhost:5433/astranet
# Prisma requires both DATABASE_URL and DIRECT_URL (prisma/schema.prisma's
# datasource block). Same value as DATABASE_URL for local dev; in production
# the two diverge — DIRECT_URL bypasses Supabase's connection pooler
# (needed for migrations), DATABASE_URL goes through it.
DIRECT_URL=postgresql://astranet:astranet_dev_password@localhost:5433/astranet

NASA_API_KEY=
N2YO_API_KEY=

# Space-Track.org (apps/api/src/clients/space-track/) — fallback satellite
# TLE source used only when CelesTrak is unreachable (see DECISIONS.md).
# Real account credentials, not an API key: register at space-track.org.
SPACETRACK_USERNAME=
SPACETRACK_PASSWORD=

NODE_ENV=development
PORT=3000
# The deployed frontend's origin (ARCHITECTURE.md §9: Cloudflare Pages, a
# different domain from this API's VPS in production) — the API's CORS
# allowlist entry (apps/api/src/app.ts). Required at boot (index.ts fails
# fast if unset). The local Vite dev server (localhost:5173) is always
# additionally allowed outside NODE_ENV=production, so this only needs to
# be the real production frontend URL when deploying.
WEB_ORIGIN=http://localhost:5173