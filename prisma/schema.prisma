generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Every aurora prediction the Causal Engine makes, stored so it can later
/// be scored — the backbone of the honesty/accuracy loop (ARCHITECTURE.md
/// §6, FORMULAS.md §8-9). Fully global: there is no account system, so a
/// row is written for every qualifying Brief view (any observer, any
/// caller) rather than being scoped to who happened to be looking.
model Prediction {
  id           String    @id @default(cuid())
  madeAt       DateTime  @default(now())
  targetTime   DateTime
  predictedKp  Float
  confidence   Float
  context      Json      @default("{}")
  actualKp     Float?
  scored       Boolean   @default(false)
  hit          Boolean?
  createdAt    DateTime  @default(now())

  @@index([scored, targetTime])
}

model Cache {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
}
