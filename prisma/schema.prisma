generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

/// Every aurora prediction the Causal Engine makes, stored so it can later
/// be scored — the backbone of the honesty/accuracy loop (ARCHITECTURE.md
/// §6, FORMULAS.md §8-9). Fully global: there is no account system, so a
/// row is written for every qualifying Brief view (any observer, any
/// caller) rather than being scoped to who happened to be looking.
model Prediction {
  id           String    @id @default(cuid())
  madeAt       DateTime  @default(now())
  targetTime   DateTime
  predictedKp  Float
  confidence   Float
  context      Json      @default("{}")
  actualKp     Float?
  scored       Boolean   @default(false)
  hit          Boolean?
  createdAt    DateTime  @default(now())

  @@index([scored, targetTime])
}

model Cache {
  key       String   @id
  value     Json
  expiresAt DateTime

  @@index([expiresAt])
}

/// Shareable Sky Card (WORKPLAN.md Phase 11) — one frozen, self-contained
/// snapshot of a Brief moment, served publicly at `/share/:id`. `id` is a
/// random URL-safe token rather than `@default(cuid())`: this row is
/// world-readable by anyone holding the id and carries the observer's
/// coordinates, so ids must not be enumerable.
model ShareCard {
  id         String   @id
  capturedAt DateTime
  latitude   Float
  longitude  Float
  snapshot   Json
  createdAt  DateTime @default(now())
}